DATABASE_URL="postgresql://stockily:stockily@localhost:5432/stockily?schema=public"

# Milestone 8 (RLS) — the running API (nx serve api / the api container)
# must connect as this restricted, non-superuser role for Postgres
# Row-Level Security to actually take effect: a superuser/BYPASSRLS role
# (DATABASE_URL's `stockily` above, needed for migrations/seed) always
# bypasses RLS regardless of policies — see the
# 20260826090000_enable_row_level_security migration, which creates this
# role. DATABASE_URL keeps being what `prisma migrate`/`db:seed` use.
APP_DATABASE_URL="postgresql://stockily_app:stockily_app@localhost:5432/stockily?schema=public"

# Auth (Milestone 1) — generate a real secret for anything beyond local dev,
# e.g. `openssl rand -hex 32`. JwtConfigModule refuses to start without one
# when NODE_ENV=production rather than silently falling back.
JWT_SECRET="dev-insecure-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# CORS (Milestone 6 hardening) — comma-separated allowlist of origins
# allowed to call this API from a browser. Defaults to the local Vite dev
# server if unset; a real deployment MUST set this to its actual web
# origin(s), e.g. "https://app.stockily.dz".
CORS_ORIGIN="http://localhost:4200"

# Email (Milestone 4/6) — optional. Leave SMTP_HOST unset to keep using
# NoOpEmailSender (invoice reminder emails are logged, not sent) — fine for
# local dev and demos. Set these to enable real sending via any SMTP
# provider (Postmark, SendGrid, SES, a plain mailbox, ...); no code change
# needed either way, see InvoicingModule's provider factory.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="apikey"
# SMTP_PASS="changeme"
# SMTP_FROM="no-reply@stockily.dz"
