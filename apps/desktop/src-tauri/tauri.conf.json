{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stockily",
  "version": "0.1.5",
  "identifier": "dz.ordi-tech.stockily",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stockily",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "publisher": "Ordi-Tech",
    "shortDescription": "Stockily — gestion de stock, factures et caisse, même sans internet",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RjkwRUQ0OEUzNzFDQTYKUldTbUhEZU8xQTc1U0dwRzFzd3pnREE3ZzNhZHpKckc3MXVjR0xKdDVYQ3ZGelF2ckpKcEw5cCsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
