// Stockily — Phase 1 data model skeleton.
// Authoritative design: docs/Action Plan.md §2 (multi-tenancy) and §3 (domain model).
//
// TODO (§2): this schema assumes shared-schema + org_id + Postgres Row-Level
// Security (RLS) as defense-in-depth, with `SET LOCAL app.tenant_id` set per
// request transaction. RLS policies themselves are NOT part of this skeleton —
// they need a dedicated migration once the RLS+pgbouncer session-variable
// interplay has been spiked (§8 risk #2). Every tenant-scoped table below
// carries orgId so that policy can be added without a model rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & modules (§2)
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @default(uuid())
  name          String
  plan          String   @default("trial")
  billingCustomerId String?
  createdAt     DateTime @default(now())

  // Seller's own legal identity for Décret Exécutif 05-468 (§9/§11) — the
  // 12 mandatory invoice mentions include the ISSUING org's own name
  // (reuses `name` above — the wireframe's "Paramètres du Business" screen
  // edits that same field, not a separate one), address,
  // NIF/NIS/RC/tax-article-number (Partner carries the same fields for the
  // BUYER side; these are the seller side, never populated at signup —
  // filled in later via that settings screen). Nullable: InvoicingService
  // blocks finalization (not org creation) until these are set, with a
  // clear pointer to that screen — see docs/MILESTONE_4.md.
  address       String?
  nif           String?
  nis           String?
  rc            String?
  taxArticle    String?
  phone         String?
  email         String?
  // A data: URL (already resized/compressed client-side before upload) —
  // simplest storage for a small logo image without standing up object
  // storage or a multipart upload endpoint for what's a rare, low-volume
  // write. Shown on the org settings screen and printed on every invoice
  // PDF next to the seller's name.
  logo          String?  @db.Text

  sites         Site[]
  users         User[]
  roles         Role[]
  entitlements  OrganizationModuleEntitlement[]
  products      Product[]
  productCategories ProductCategory[]
  batches       Batch[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]
  expiryAlerts  ExpiryAlert[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  invoices      Invoice[]
  invoiceCounters InvoiceCounter[]
  taxRates      TaxRate[]
  partners      Partner[]
  auditLogs     AuditLog[]
  barcodeLabels BarcodeLabel[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  purchaseOrderCounters PurchaseOrderCounter[]
  salesOrders SalesOrder[]
  salesOrderCounters SalesOrderCounter[]
  partnerProductPrices PartnerProductPrice[]

  @@map("organizations")
}

// One row per product module — all 13 from docs/Action Plan.md §1, not just
// the 5 wired up in Phase 1. `dependencies` is a business decision (§4):
// quality depends on stock; invoicing does not.
model Module {
  id           String   @id @default(uuid())
  key          String   @unique // e.g. "stock", "quality", "invoicing", "sites", "scan", "purchasing", "orders", "delivery", "crm", "notifications", "returns", "accounting", "reporting"
  name         String
  phase        Int      // 1, 2, or 3
  dependencies String[] // module keys this one requires to be active

  entitlements OrganizationModuleEntitlement[]

  @@map("modules")
}

model OrganizationModuleEntitlement {
  id          String    @id @default(uuid())
  orgId       String
  moduleId    String
  status      String    @default("trial") // active | trial | suspended | cancelled
  activatedAt DateTime  @default(now())
  // 15-day free trial, no card required (Action Plan §11). Only meaningful
  // when status = "trial" — ModuleEntitlementGuard treats a trial as active
  // only while now() < trialEndsAt; null for non-trial statuses.
  trialEndsAt DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([orgId, moduleId])
  @@index([orgId])
  @@map("organization_module_entitlements")
}

model Site {
  id       String  @id @default(uuid())
  orgId    String
  name     String
  address  String?
  isActive Boolean @default(true)

  organization    Organization      @relation(fields: [orgId], references: [id])
  userRoles       UserRole[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  transfersFrom   StockTransfer[]   @relation("transferFromSite")
  transfersTo     StockTransfer[]   @relation("transferToSite")
  invoices        Invoice[]
  purchaseOrders  PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  salesOrders     SalesOrder[]

  @@index([orgId])
  @@map("sites")
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  email        String   @unique // globally unique across the platform (§2 simplicity decision)
  passwordHash String
  createdAt    DateTime @default(now())

  organization   Organization    @relation(fields: [orgId], references: [id])
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]

  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String // sha256 of the raw token — high-entropy random value, not a password, so a fast hash suffices (no bcrypt needed)
  expiresAt DateTime // absolute expiry (JWT_REFRESH_TTL_DAYS at issuance) — added for Milestone 1, missing from the original skeleton
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// System-default roles (Super Admin, Gestionnaire, Opérateur Entrepôt,
// Commercial, Comptable/Finance) have orgId = null; a future custom role is
// org-scoped.
model Role {
  id       String  @id @default(uuid())
  orgId    String?
  name     String
  isSystem Boolean @default(false)

  organization    Organization?     @relation(fields: [orgId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([orgId])
  @@map("roles")
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String
  moduleId String
  action   String // e.g. "stock.movement.create", "invoice.void"

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId, action])
  @@map("role_permissions")
}

// siteId nullable = org-wide role assignment vs. site-scoped (§2).
model UserRole {
  id     String  @id @default(uuid())
  userId String
  roleId String
  siteId String?

  user User  @relation(fields: [userId], references: [id])
  role Role  @relation(fields: [roleId], references: [id])
  site Site? @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Stock (§3) — stockLevels is a projection; stockMovements is the source of
// truth, append-only and immutable (§9 decision #10: corrections are always a
// new offsetting movement, never an edit/delete).
// ---------------------------------------------------------------------------

model ProductCategory {
  id       String  @id @default(uuid())
  orgId    String
  name     String
  parentId String?

  organization Organization      @relation(fields: [orgId], references: [id])
  parent       ProductCategory?  @relation("categoryTree", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("categoryTree")
  products     Product[]

  @@index([orgId])
  @@map("product_categories")
}

model Product {
  id            String  @id @default(uuid())
  orgId         String
  sku           String
  name          String
  categoryId    String?
  unitOfMeasure String  @default("unit") // single UoM per product, no case/unit conversion (§9)
  isLotTracked  Boolean @default(false)
  minThreshold  Decimal? @db.Decimal(14, 3)
  maxThreshold  Decimal? @db.Decimal(14, 3)
  averageCost   Decimal  @default(0) @db.Decimal(14, 2) // Weighted Average Cost (§9), recalculated on each IN movement
  // Default retail sale price — distinct from averageCost (purchase-side
  // WAC). Nullable: existing/newly-created products have none until set,
  // and a line can still always override it at invoice/checkout time.
  sellPrice     Decimal? @db.Decimal(14, 2)
  // The product's own real-world barcode (EAN-13/UPC/etc., printed by the
  // manufacturer) — distinct from `sku` (this org's internal reference) and
  // from BarcodeLabel (a Stockily-generated code that must be printed and
  // stuck on before it scans to anything). Setting this lets Scan resolve
  // the box's existing barcode immediately, no label generation step first.
  // Nullable + a nullable-safe compound unique (Postgres allows any number
  // of NULLs in a unique index) since most products won't have one set.
  barcode       String?
  // Soft delete — never physically removed (too many FKs from stock/sales/
  // purchasing/invoicing history point at a product to ever hard-delete it).
  // Set instead of removing the row; every "list active products" read path
  // filters `deletedAt: null`, but historical joins (an old invoice/order
  // line's own `product` relation) are left unfiltered so past documents
  // keep rendering correctly.
  deletedAt     DateTime?
  // Packaging hint only — units per carton, used by the Ventes/Achats line
  // editors to turn "N cartons" into a quantity. Stock stays counted in
  // units; this is not a second unit of measure.
  unitsPerCarton Int?

  organization Organization     @relation(fields: [orgId], references: [id])
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  stockLevels  StockLevel[]
  batches      Batch[]
  barcodeLabels BarcodeLabel[]
  invoiceLines InvoiceLine[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  salesOrderLines SalesOrderLine[]
  partnerProductPrices PartnerProductPrice[]

  @@unique([orgId, sku])
  @@unique([orgId, barcode])
  @@index([orgId])
  @@map("products")
}

// Projection only — stockMovements is the ledger of record.
model StockLevel {
  id                 String  @id @default(uuid())
  productId          String
  siteId             String
  quantityOnHand     Decimal @default(0) @db.Decimal(14, 3)
  quantityQuarantined Decimal @default(0) @db.Decimal(14, 3) // failed QC / expired stock, excluded from sellable qty (§9)
  quantityReserved   Decimal @default(0) @db.Decimal(14, 3) // stubbed for Phase 2 (Commandes)

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@unique([productId, siteId])
  @@map("stock_levels")
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

// Append-only, immutable ledger (§9 decision #10). A mistaken entry is
// corrected only via a new offsetting movement — never edited or deleted.
model StockMovement {
  id                String            @id @default(uuid())
  orgId             String
  productId         String?
  siteId            String
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 3)
  batchId           String?
  // The supplier an IN was received from, or the customer an OUT was sold
  // to — nullable because most movements (transfers, adjustments, a
  // walk-in sale) have no counterparty at all. Deliberately a real FK
  // (not folded into relatedEntityType/relatedEntityId) so it can be
  // joined/displayed directly, the same as batchId.
  partnerId         String?
  relatedEntityType String? // e.g. "invoice_line", "stock_transfer", "scan", "manual"
  relatedEntityId   String?
  performedBy       String?
  occurredAt        DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])

  @@index([orgId, occurredAt])
  @@index([productId])
  @@index([partnerId])
  @@map("stock_movements")
}

model StockTransfer {
  id           String   @id @default(uuid())
  orgId        String
  fromSiteId   String
  toSiteId     String
  productId    String
  quantity     Decimal  @db.Decimal(14, 3)
  batchId      String?
  status       String   @default("prepared") // prepared | in_transit | delivered
  // The ledger move (both legs, atomically) now fires once, on the
  // prepared/in_transit -> delivered transition, not at creation — a
  // transfer sitting at "in_transit" no longer makes stock appear
  // available at the destination before it has physically arrived (found
  // by actually creating one and watching the destination site's stock
  // count update immediately, which contradicted its own "en transit"
  // label). See SitesService.createTransfer/updateTransfer.
  deliveredAt  DateTime?
  driverName   String?
  driverPhone  String?
  vehicleRef   String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  fromSite     Site         @relation("transferFromSite", fields: [fromSiteId], references: [id])
  toSite       Site         @relation("transferToSite", fields: [toSiteId], references: [id])

  @@index([orgId])
  @@map("stock_transfers")
}

model BarcodeLabel {
  id         String  @id @default(uuid())
  orgId      String
  productId  String?
  batchId    String?
  codeValue  String
  symbology  String  @default("EAN13")
  printedCount Int   @default(0)

  organization Organization @relation(fields: [orgId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])

  @@unique([orgId, codeValue])
  @@index([orgId])
  @@map("barcode_labels")
}

// ---------------------------------------------------------------------------
// Quality (§3) — quality_checks/non_conformities have a NULLABLE batchId:
// a quality check is not limited to lot-tracked products. A non-lot-tracked
// product (e.g. a belt) still needs an ad hoc check — a delivery-defect
// inspection with no batch to attach to — so these reference the product
// directly when there is no batch (explicit correction from the user).
// ---------------------------------------------------------------------------

model Batch {
  id             String   @id @default(uuid())
  orgId          String
  productId      String
  lotNumber      String
  expiryDate     DateTime?
  quantityReceived Decimal @db.Decimal(14, 3)
  receivedAt     DateTime @default(now())
  status         String   @default("active") // active | quarantined | depleted

  organization  Organization    @relation(fields: [orgId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]
  expiryAlerts  ExpiryAlert[]
  barcodeLabels BarcodeLabel[]
  purchaseReceiptLines PurchaseReceiptLine[]

  @@index([orgId])
  @@index([productId])
  @@map("batches")
}

model QualityCheck {
  id        String   @id @default(uuid())
  orgId     String
  productId String
  batchId   String? // nullable — see note above
  checkedBy String?
  result    String  // conforme | non_conforme
  notes     String?
  checkedAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  purchaseReceiptLines PurchaseReceiptLine[]

  @@index([orgId])
  @@map("quality_checks")
}

model NonConformity {
  id             String   @id @default(uuid())
  orgId          String
  productId      String
  batchId        String? // nullable — see note above
  severity       String  @default("normal")
  status         String  @default("open") // open | resolved
  resolutionNotes String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([orgId])
  @@map("non_conformities")
}

// Logged once per batch to avoid re-alerting; doubles as a ready-made source
// for Phase 2 Notifications.
model ExpiryAlert {
  id        String   @id @default(uuid())
  orgId     String
  batchId   String
  alertedAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])

  @@unique([batchId])
  @@map("expiry_alerts")
}

// ---------------------------------------------------------------------------
// Invoicing (§3) — Décret Exécutif 05-468 compliance fields, DZD-only,
// gapless per-org sequential numbering, unified partners table.
// ---------------------------------------------------------------------------

model TaxRate {
  id        String  @id @default(uuid())
  orgId     String
  name      String
  rate      Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false)

  organization    Organization     @relation(fields: [orgId], references: [id])
  invoiceLines    InvoiceLine[]
  salesOrderLines SalesOrderLine[]

  @@index([orgId])
  @@map("tax_rates")
}

// Unified customer/supplier entity (§9 decision #9) — one real-world company
// can be both, flagged via booleans rather than duplicated as two records.
model Partner {
  id         String  @id @default(uuid())
  orgId      String
  name       String
  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)
  // Previously required (2022 finance law ties buyer VAT deduction to it) —
  // made optional per explicit user decision: a Partner can be registered
  // before its NIF is on file, and an invoice can still be finalized for it
  // (see invoicing.service.ts's finalizeInvoice — the compliance guard that
  // used to block that was removed). The PDF/print template renders the
  // "NIF :" / "NIS :" label with an empty value rather than omitting it.
  nif        String?
  nis        String?
  rc         String?
  taxArticle String?
  address    String?
  phone      String?
  email      String?
  // Milestone 10 (Gestion Achats/Ventes) — default payment terms, days
  // between an invoice's finalization and its due date. Nullable: most
  // existing partners have none on file; Invoice.dueDate is simply left
  // unset when absent, same "optional, not silently assumed" pattern as
  // averageCost's unitCost handling. Applies to either side (a SUPPLIER
  // partner's terms drive their own invoices to us; kept on the same
  // unified table per the "Partner stays unified" decision rather than
  // splitting Customer/Supplier).
  paymentTermsNetDays Int?

  organization   Organization    @relation(fields: [orgId], references: [id])
  invoices       Invoice[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  productPrices  PartnerProductPrice[]

  // Soft delete — never physically removed. See Product.deletedAt for the
  // reasoning; every list/get query filters `deletedAt: null`.
  deletedAt DateTime?

  @@index([orgId])
  @@map("partners")
}

enum InvoiceType {
  CUSTOMER
  SUPPLIER
}

// number/status lifecycle differs by type — see docs/MILESTONE_4.md for the
// full reasoning, in short:
//   CUSTOMER (an invoice THIS org issues): draft (number=null, mutable) ->
//     finalize assigns the gapless number via InvoiceCounter below and
//     triggers stock OUT movements for stock-linked lines -> unpaid ->
//     partially_paid -> paid. Only a draft may be voided.
//   SUPPLIER (a bill THIS org received): created already carrying the
//     SUPPLIER's own reference as `number` (never auto-assigned, never
//     compliance-numbered by us, no stock movement of its own — receiving
//     goes through Purchasing (Milestone 9) instead, which is what actually
//     posts the stock IN movement; `purchaseOrderId` below is a purely
//     optional traceability link between the two) -> unpaid ->
//     partially_paid -> paid.
model Invoice {
  id            String      @id @default(uuid())
  orgId         String
  siteId        String      // added for Milestone 4 — a stock-deducting line needs to know which site's stock to draw down; independent of the org-wide numbering sequence.
  type          InvoiceType
  number        String?     // nullable: null while a CUSTOMER invoice is still a draft (§8/§9 — Décret 05-468)
  partnerId     String?     // null = "vente comptoir" / walk-in — the confirmed override path, not a separate flag (see docs/MILESTONE_4.md)
  currency      String      @default("DZD") // DZD-only in Phase 1 (§9); field kept for a future multi-currency addition
  status        String      @default("draft") // draft | unpaid | partially_paid | paid | void
  issuedAt      DateTime    @default(now())
  finalizedAt   DateTime?   // set when a CUSTOMER invoice's number is assigned; set at creation time for SUPPLIER invoices
  transmissionStatus String? // placeholder for Algeria's DGI e-invoicing/CTC platform — no active integration yet (§8/§9)
  // Milestone 9 — optional link from a SUPPLIER invoice to the purchase
  // order it's settling, for reconciliation only. Nothing is conditioned on
  // it (no blocking if absent) — purely additive, per Action Plan §5.
  purchaseOrderId String?
  // Milestone 10 — optional link from a CUSTOMER invoice to the commande
  // (SalesOrder) it (partially) fulfills, symmetric to purchaseOrderId
  // above. A commande can generate more than one invoice over time
  // (partial invoicing), so this is invoice-level "which commande" for
  // easy querying; InvoiceLine.salesOrderLineId below is the line-level
  // detail actually used to release the matching stock reservation.
  salesOrderId String?
  // Milestone 10 — computed once at creation from partner.paymentTermsNetDays
  // (see InvoicingService.createInvoice) when the partner has terms on file;
  // null otherwise (no due-date tracking for that partner). Replaces the
  // fixed 30-day REMINDER_AFTER_DAYS approximation with a real per-partner
  // figure where available.
  dueDate DateTime?
  // Soft delete — never physically removed. See Product.deletedAt for the
  // rationale; same convention here.
  deletedAt DateTime?

  organization Organization  @relation(fields: [orgId], references: [id])
  site         Site          @relation(fields: [siteId], references: [id])
  partner      Partner?      @relation(fields: [partnerId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  reminders    InvoiceReminder[]

  @@unique([orgId, number])
  @@index([orgId])
  @@map("invoices")
}

// Backs the gapless, per-organization, per-calendar-year sequential number
// (§8/§9 — Décret 05-468). Scoped by year to match the "FA-2026-000184"
// format already shown in docs/Wireframes.html — an explicit interpretation
// of "gapless per organization" the Action Plan itself didn't pin down to a
// specific format, documented in docs/MILESTONE_4.md. Incremented via a
// single atomic `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` statement
// (not a read-then-write from application code), which is safe under
// concurrent finalization because Postgres serializes concurrent statements
// touching the same row via its normal row-level locking — see
// InvoicingService.finalize's own comment for the exact mechanism.
model InvoiceCounter {
  orgId      String
  year       Int
  lastNumber Int @default(0)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, year])
  @@map("invoice_counters")
}

model InvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String
  productId       String? // nullable — a services-only business can invoice with no Stock module at all
  description     String
  quantity        Decimal @db.Decimal(14, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(14, 2)
  taxRateId       String?
  // Milestone 10 — set only when this line was generated from a Ventes
  // commande line (SalesService.invoiceSalesOrder); null for every other
  // invoice line (manual Invoicing entry, Vente rapide, SUPPLIER lines).
  // finalizeInvoice reads it to release the matching reservation and
  // increment SalesOrderLine.quantityInvoiced — purely additive, no
  // existing invoice line has this set.
  salesOrderLineId String?

  invoice        Invoice         @relation(fields: [invoiceId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  salesOrderLine SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])

  @@map("invoice_lines")
}

// Multiple partial payments per invoice supported (§9 decision #8) — status
// tracks unpaid -> partially_paid -> paid against a running balance.
model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model InvoiceReminder {
  id        String   @id @default(uuid())
  invoiceId String
  sentAt    DateTime @default(now())
  channel   String   @default("email")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_reminders")
}

// ---------------------------------------------------------------------------
// Purchasing / Achats (Milestone 9, Phase 2) — the supplier-side receiving
// cycle. Header+lines, same proven pattern as Invoice/InvoiceLine. Receiving
// posts real stock IN movements through StockService (Action Plan §5:
// "Achats receipt -> additive IN stock_movement + reuse of the
// already-modeled quality_check") — no separate ledger of its own.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id           String    @id @default(uuid())
  orgId        String
  siteId       String    // destination site for the goods
  supplierId   String    // Partner with isSupplier = true
  number       String?   // human-readable reference (e.g. "BC-2026-000001") — no legal gapless requirement like Invoice, but reuses the same atomic counter pattern for consistency; null until assigned
  status       String    @default("draft") // draft | confirmed | partially_received | received | cancelled | rfq | rfq_rejected
  expectedDate DateTime?
  notes        String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  // Milestone 10 (RFQ / price comparison) — correlates the N candidate
  // PurchaseOrder rows (one per invited supplier, status "rfq") created
  // together for one comparison round; null for a normal PO. Awarding one
  // flips it to "confirmed" (assigns a real number); the rest flip to
  // "rfq_rejected", kept for audit history rather than deleted.
  comparisonGroupId String?

  organization Organization        @relation(fields: [orgId], references: [id])
  site         Site                @relation(fields: [siteId], references: [id])
  supplier     Partner             @relation(fields: [supplierId], references: [id])
  lines        PurchaseOrderLine[]
  receipts     PurchaseReceipt[]
  invoices     Invoice[]

  // Soft delete — never physically removed. See Product.deletedAt for the
  // reasoning; every list/get query filters `deletedAt: null`.
  deletedAt DateTime?

  @@unique([orgId, number])
  @@index([orgId])
  @@index([comparisonGroupId])
  @@map("purchase_orders")
}

// Mirrors InvoiceCounter's mechanism exactly (same atomic
// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` statement) purely for
// pattern consistency — no Décret 05-468-style legal gapless requirement
// applies to a purchase order reference.
model PurchaseOrderCounter {
  orgId      String
  year       Int
  lastNumber Int @default(0)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, year])
  @@map("purchase_order_counters")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Decimal @db.Decimal(14, 3)
  quantityReceived Decimal @default(0) @db.Decimal(14, 3) // cumulative, updated on each receipt
  unitCost         Decimal @db.Decimal(14, 2) // planning/expected cost — the receipt line's own unitCost is what actually feeds the WAC
  // Soft delete — never physically removed. See Product.deletedAt for the
  // rationale; same convention here.
  deletedAt        DateTime?

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  product       Product               @relation(fields: [productId], references: [id])
  receiptLines  PurchaseReceiptLine[]

  @@map("purchase_order_lines")
}

// purchaseOrderId is nullable — "réception libre": receiving goods with no
// prior purchase order, for the smaller/informal-supplier case (same
// reasoning as Quality's product-direct check having no batch to attach to).
model PurchaseReceipt {
  id              String   @id @default(uuid())
  orgId           String
  purchaseOrderId String?
  siteId          String
  receivedBy      String?
  receivedAt      DateTime @default(now())
  notes           String?
  // Milestone 10 (coût de revient / landed cost) — one lump sum for this
  // receipt's transport/douane/assurance, pro-rated across lines by value
  // (see PurchasingService.receiveGoods) into each line's landedCostShare
  // below. Absent/zero means zero behavior change from Milestone 9 — the
  // receipt's raw unitCost per line is what feeds the WAC, exactly as
  // before.
  landedCostAmount Decimal? @db.Decimal(14, 2)
  landedCostNotes  String?

  organization  Organization          @relation(fields: [orgId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  site          Site                  @relation(fields: [siteId], references: [id])
  lines         PurchaseReceiptLine[]

  @@index([orgId])
  @@map("purchase_receipts")
}

// purchaseOrderLineId nullable for the same "réception libre" reason as
// PurchaseReceipt.purchaseOrderId. batchId/qualityCheckId are set only when
// the receiving flow actually created a lot / ran a quality check for this
// line (Product.isLotTracked-gated, same as everywhere else in this schema).
model PurchaseReceiptLine {
  id                  String  @id @default(uuid())
  receiptId           String
  purchaseOrderLineId String?
  productId           String
  quantityReceived    Decimal @db.Decimal(14, 3)
  unitCost            Decimal @db.Decimal(14, 2) // raw supplier-negotiated cost — kept as-is for last-price-paid history, separate from the landed cost basis actually fed to the WAC
  batchId             String?
  qualityCheckId      String?
  // Milestone 10 — this line's allocated share of the receipt's
  // landedCostAmount, persisted for audit/traceability rather than
  // recomputed on read. landedUnitCost (what StockService.recordMovement
  // actually receives) = unitCost + landedCostShare / quantityReceived.
  landedCostShare     Decimal? @db.Decimal(14, 2)

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  product           Product           @relation(fields: [productId], references: [id])
  batch             Batch?            @relation(fields: [batchId], references: [id])
  qualityCheck      QualityCheck?     @relation(fields: [qualityCheckId], references: [id])

  @@map("purchase_receipt_lines")
}

// ---------------------------------------------------------------------------
// Ventes / Gestion des Ventes (Milestone 10, Phase 2) — the customer-side
// mirror of Purchasing. One model for devis (quote) and commande (order) —
// `kind` distinguishes them, `status` uses a kind-dependent vocabulary
// (see PLAN.md for the full reasoning). A commande reserves stock
// (StockLevel.quantityReserved, finally wired up here) and can generate one
// or more partial invoices over time; a devis reserves nothing. Devis,
// commande, and facture are independent entry points — none is a mandatory
// gate for the next, exactly like Achats' BC/réception/facture fournisseur.
// ---------------------------------------------------------------------------

model SalesOrder {
  id                      String    @id @default(uuid())
  orgId                   String
  siteId                  String    // fulfillment site — reservation is per (product, site), same role as PurchaseOrder.siteId
  customerId              String    // Partner with isCustomer = true
  kind                    String    @default("quote") // quote | order — devis vs commande; promotion flips this in place on the same row
  number                  String?   // DEV-YYYY-NNNNNN (quote) or CMD-YYYY-NNNNNN (order); null until assigned
  // Set once, at promotion, to the DEV-... number this commande started
  // life as (a promoted quote gets a FRESH CMD-... number rather than
  // keeping its devis number — this is where the original is preserved).
  promotedFromQuoteNumber String?
  status                  String    @default("draft")
  // kind=quote:  draft | sent | accepted | expired | cancelled
  // kind=order:  confirmed | partially_invoiced | invoiced | cancelled
  expectedDate            DateTime?
  notes                   String?
  createdBy               String?
  createdAt               DateTime  @default(now())

  organization Organization     @relation(fields: [orgId], references: [id])
  site         Site             @relation(fields: [siteId], references: [id])
  customer     Partner          @relation(fields: [customerId], references: [id])
  lines        SalesOrderLine[]
  invoices     Invoice[]

  // Soft delete — never physically removed. See Product.deletedAt for the
  // reasoning; every list/get query filters `deletedAt: null`.
  deletedAt DateTime?

  @@unique([orgId, number])
  @@index([orgId])
  @@map("sales_orders")
}

// Mirrors PurchaseOrderCounter but keyed additionally by docType ("quote" |
// "order") since devis and commandes each have their own numbering
// sequence/prefix (DEV-/CMD-) rather than sharing one counter.
model SalesOrderCounter {
  orgId      String
  year       Int
  docType    String // "quote" | "order"
  lastNumber Int    @default(0)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, year, docType])
  @@map("sales_order_counters")
}

model SalesOrderLine {
  id               String   @id @default(uuid())
  salesOrderId     String
  productId        String?  // nullable — a services-only line, mirrors InvoiceLine.productId; no reservation applies since there's no stock to reserve
  description      String   // needed when productId is null, same as InvoiceLine
  quantityOrdered  Decimal  @db.Decimal(14, 3)
  quantityInvoiced Decimal  @default(0) @db.Decimal(14, 3) // cumulative, mirrors PurchaseOrderLine.quantityReceived — the still-reserved amount is always (quantityOrdered - quantityInvoiced), not stored separately
  unitPrice        Decimal  @db.Decimal(14, 2) // resolved from PartnerProductPrice or Product.sellPrice at line-build time, freely overridable
  discountPercent  Decimal? @db.Decimal(5, 2)
  taxRateId        String?
  // Soft delete — never physically removed. See Product.deletedAt for the
  // rationale; same convention here.
  deletedAt        DateTime?

  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id])
  product       Product?      @relation(fields: [productId], references: [id])
  taxRate       TaxRate?      @relation(fields: [taxRateId], references: [id])
  invoiceLines  InvoiceLine[]

  @@map("sales_order_lines")
}

// Negotiated per-customer pricing (Ventes decision: "tarifs spécifiques
// par client nécessaires") — looked up when building a devis/commande
// line, falling back to Product.sellPrice when no entry exists for that
// (partner, product) pair. Exactly one of unitPrice/discountPercent is
// expected to be set, not both — a fixed negotiated price, or a
// negotiated discount off the product's own sellPrice.
model PartnerProductPrice {
  id              String    @id @default(uuid())
  orgId           String
  partnerId       String
  productId       String
  unitPrice       Decimal?  @db.Decimal(14, 2)
  discountPercent Decimal?  @db.Decimal(5, 2)
  validFrom       DateTime?
  validTo         DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  partner      Partner      @relation(fields: [partnerId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([orgId, partnerId, productId])
  @@index([orgId])
  @@map("partner_product_prices")
}

// ---------------------------------------------------------------------------
// Audit (§4) — generic, populated via an interceptor across Stock/Quality/
// Invoicing from day one; also the input for Phase 3 Comptabilité/Rapports.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String?
  entityType String
  entityId   String
  action     String
  diff       Json?
  occurredAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, occurredAt])
  @@map("audit_log")
}
