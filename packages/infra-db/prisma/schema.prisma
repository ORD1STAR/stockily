// Stockily — Phase 1 data model skeleton.
// Authoritative design: docs/Action Plan.md §2 (multi-tenancy) and §3 (domain model).
//
// TODO (§2): this schema assumes shared-schema + org_id + Postgres Row-Level
// Security (RLS) as defense-in-depth, with `SET LOCAL app.tenant_id` set per
// request transaction. RLS policies themselves are NOT part of this skeleton —
// they need a dedicated migration once the RLS+pgbouncer session-variable
// interplay has been spiked (§8 risk #2). Every tenant-scoped table below
// carries orgId so that policy can be added without a model rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & modules (§2)
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @default(uuid())
  name          String
  plan          String   @default("trial")
  billingCustomerId String?
  createdAt     DateTime @default(now())

  // Seller's own legal identity for Décret Exécutif 05-468 (§9/§11) — the
  // 12 mandatory invoice mentions include the ISSUING org's own name
  // (reuses `name` above — the wireframe's "Paramètres du Business" screen
  // edits that same field, not a separate one), address,
  // NIF/NIS/RC/tax-article-number (Partner carries the same fields for the
  // BUYER side; these are the seller side, never populated at signup —
  // filled in later via that settings screen). Nullable: InvoicingService
  // blocks finalization (not org creation) until these are set, with a
  // clear pointer to that screen — see docs/MILESTONE_4.md.
  address       String?
  nif           String?
  nis           String?
  rc            String?
  taxArticle    String?
  phone         String?
  email         String?

  sites         Site[]
  users         User[]
  roles         Role[]
  entitlements  OrganizationModuleEntitlement[]
  products      Product[]
  productCategories ProductCategory[]
  batches       Batch[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]
  expiryAlerts  ExpiryAlert[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  invoices      Invoice[]
  invoiceCounters InvoiceCounter[]
  taxRates      TaxRate[]
  partners      Partner[]
  auditLogs     AuditLog[]
  barcodeLabels BarcodeLabel[]

  @@map("organizations")
}

// One row per product module — all 13 from docs/Action Plan.md §1, not just
// the 5 wired up in Phase 1. `dependencies` is a business decision (§4):
// quality depends on stock; invoicing does not.
model Module {
  id           String   @id @default(uuid())
  key          String   @unique // e.g. "stock", "quality", "invoicing", "sites", "scan", "purchasing", "orders", "delivery", "crm", "notifications", "returns", "accounting", "reporting"
  name         String
  phase        Int      // 1, 2, or 3
  dependencies String[] // module keys this one requires to be active

  entitlements OrganizationModuleEntitlement[]

  @@map("modules")
}

model OrganizationModuleEntitlement {
  id          String    @id @default(uuid())
  orgId       String
  moduleId    String
  status      String    @default("trial") // active | trial | suspended | cancelled
  activatedAt DateTime  @default(now())
  // 15-day free trial, no card required (Action Plan §11). Only meaningful
  // when status = "trial" — ModuleEntitlementGuard treats a trial as active
  // only while now() < trialEndsAt; null for non-trial statuses.
  trialEndsAt DateTime?

  organization Organization @relation(fields: [orgId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([orgId, moduleId])
  @@index([orgId])
  @@map("organization_module_entitlements")
}

model Site {
  id       String  @id @default(uuid())
  orgId    String
  name     String
  address  String?
  isActive Boolean @default(true)

  organization    Organization      @relation(fields: [orgId], references: [id])
  userRoles       UserRole[]
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  transfersFrom   StockTransfer[]   @relation("transferFromSite")
  transfersTo     StockTransfer[]   @relation("transferToSite")
  invoices        Invoice[]

  @@index([orgId])
  @@map("sites")
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  email        String   @unique // globally unique across the platform (§2 simplicity decision)
  passwordHash String
  createdAt    DateTime @default(now())

  organization   Organization    @relation(fields: [orgId], references: [id])
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]

  @@index([orgId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String // sha256 of the raw token — high-entropy random value, not a password, so a fast hash suffices (no bcrypt needed)
  expiresAt DateTime // absolute expiry (JWT_REFRESH_TTL_DAYS at issuance) — added for Milestone 1, missing from the original skeleton
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// System-default roles (Super Admin, Gestionnaire, Opérateur Entrepôt,
// Commercial, Comptable/Finance) have orgId = null; a future custom role is
// org-scoped.
model Role {
  id       String  @id @default(uuid())
  orgId    String?
  name     String
  isSystem Boolean @default(false)

  organization    Organization?     @relation(fields: [orgId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([orgId])
  @@map("roles")
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String
  moduleId String
  action   String // e.g. "stock.movement.create", "invoice.void"

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId, action])
  @@map("role_permissions")
}

// siteId nullable = org-wide role assignment vs. site-scoped (§2).
model UserRole {
  id     String  @id @default(uuid())
  userId String
  roleId String
  siteId String?

  user User  @relation(fields: [userId], references: [id])
  role Role  @relation(fields: [roleId], references: [id])
  site Site? @relation(fields: [siteId], references: [id])

  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Stock (§3) — stockLevels is a projection; stockMovements is the source of
// truth, append-only and immutable (§9 decision #10: corrections are always a
// new offsetting movement, never an edit/delete).
// ---------------------------------------------------------------------------

model ProductCategory {
  id       String  @id @default(uuid())
  orgId    String
  name     String
  parentId String?

  organization Organization      @relation(fields: [orgId], references: [id])
  parent       ProductCategory?  @relation("categoryTree", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("categoryTree")
  products     Product[]

  @@index([orgId])
  @@map("product_categories")
}

model Product {
  id            String  @id @default(uuid())
  orgId         String
  sku           String
  name          String
  categoryId    String?
  unitOfMeasure String  @default("unit") // single UoM per product, no case/unit conversion (§9)
  isLotTracked  Boolean @default(false)
  minThreshold  Decimal? @db.Decimal(14, 3)
  maxThreshold  Decimal? @db.Decimal(14, 3)
  averageCost   Decimal  @default(0) @db.Decimal(14, 2) // Weighted Average Cost (§9), recalculated on each IN movement

  organization Organization     @relation(fields: [orgId], references: [id])
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  stockLevels  StockLevel[]
  batches      Batch[]
  barcodeLabels BarcodeLabel[]
  invoiceLines InvoiceLine[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@map("products")
}

// Projection only — stockMovements is the ledger of record.
model StockLevel {
  id                 String  @id @default(uuid())
  productId          String
  siteId             String
  quantityOnHand     Decimal @default(0) @db.Decimal(14, 3)
  quantityQuarantined Decimal @default(0) @db.Decimal(14, 3) // failed QC / expired stock, excluded from sellable qty (§9)
  quantityReserved   Decimal @default(0) @db.Decimal(14, 3) // stubbed for Phase 2 (Commandes)

  product Product @relation(fields: [productId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])

  @@unique([productId, siteId])
  @@map("stock_levels")
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

// Append-only, immutable ledger (§9 decision #10). A mistaken entry is
// corrected only via a new offsetting movement — never edited or deleted.
model StockMovement {
  id                String            @id @default(uuid())
  orgId             String
  productId         String?
  siteId            String
  type              StockMovementType
  quantity          Decimal           @db.Decimal(14, 3)
  batchId           String?
  // The supplier an IN was received from, or the customer an OUT was sold
  // to — nullable because most movements (transfers, adjustments, a
  // walk-in sale) have no counterparty at all. Deliberately a real FK
  // (not folded into relatedEntityType/relatedEntityId) so it can be
  // joined/displayed directly, the same as batchId.
  partnerId         String?
  relatedEntityType String? // e.g. "invoice_line", "stock_transfer", "scan", "manual"
  relatedEntityId   String?
  performedBy       String?
  occurredAt        DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  site         Site         @relation(fields: [siteId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])
  partner      Partner?     @relation(fields: [partnerId], references: [id])

  @@index([orgId, occurredAt])
  @@index([productId])
  @@index([partnerId])
  @@map("stock_movements")
}

model StockTransfer {
  id           String   @id @default(uuid())
  orgId        String
  fromSiteId   String
  toSiteId     String
  productId    String
  quantity     Decimal  @db.Decimal(14, 3)
  batchId      String?
  status       String   @default("prepared") // prepared | in_transit | delivered
  // The ledger move (both legs, atomically) now fires once, on the
  // prepared/in_transit -> delivered transition, not at creation — a
  // transfer sitting at "in_transit" no longer makes stock appear
  // available at the destination before it has physically arrived (found
  // by actually creating one and watching the destination site's stock
  // count update immediately, which contradicted its own "en transit"
  // label). See SitesService.createTransfer/updateTransfer.
  deliveredAt  DateTime?
  driverName   String?
  driverPhone  String?
  vehicleRef   String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  fromSite     Site         @relation("transferFromSite", fields: [fromSiteId], references: [id])
  toSite       Site         @relation("transferToSite", fields: [toSiteId], references: [id])

  @@index([orgId])
  @@map("stock_transfers")
}

model BarcodeLabel {
  id         String  @id @default(uuid())
  orgId      String
  productId  String?
  batchId    String?
  codeValue  String
  symbology  String  @default("EAN13")
  printedCount Int   @default(0)

  organization Organization @relation(fields: [orgId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])

  @@unique([orgId, codeValue])
  @@index([orgId])
  @@map("barcode_labels")
}

// ---------------------------------------------------------------------------
// Quality (§3) — quality_checks/non_conformities have a NULLABLE batchId:
// a quality check is not limited to lot-tracked products. A non-lot-tracked
// product (e.g. a belt) still needs an ad hoc check — a delivery-defect
// inspection with no batch to attach to — so these reference the product
// directly when there is no batch (explicit correction from the user).
// ---------------------------------------------------------------------------

model Batch {
  id             String   @id @default(uuid())
  orgId          String
  productId      String
  lotNumber      String
  expiryDate     DateTime?
  quantityReceived Decimal @db.Decimal(14, 3)
  receivedAt     DateTime @default(now())
  status         String   @default("active") // active | quarantined | depleted

  organization  Organization    @relation(fields: [orgId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]
  qualityChecks QualityCheck[]
  nonConformities NonConformity[]
  expiryAlerts  ExpiryAlert[]
  barcodeLabels BarcodeLabel[]

  @@index([orgId])
  @@index([productId])
  @@map("batches")
}

model QualityCheck {
  id        String   @id @default(uuid())
  orgId     String
  productId String
  batchId   String? // nullable — see note above
  checkedBy String?
  result    String  // conforme | non_conforme
  notes     String?
  checkedAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([orgId])
  @@map("quality_checks")
}

model NonConformity {
  id             String   @id @default(uuid())
  orgId          String
  productId      String
  batchId        String? // nullable — see note above
  severity       String  @default("normal")
  status         String  @default("open") // open | resolved
  resolutionNotes String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  batch        Batch?       @relation(fields: [batchId], references: [id])

  @@index([orgId])
  @@map("non_conformities")
}

// Logged once per batch to avoid re-alerting; doubles as a ready-made source
// for Phase 2 Notifications.
model ExpiryAlert {
  id        String   @id @default(uuid())
  orgId     String
  batchId   String
  alertedAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  batch        Batch        @relation(fields: [batchId], references: [id])

  @@unique([batchId])
  @@map("expiry_alerts")
}

// ---------------------------------------------------------------------------
// Invoicing (§3) — Décret Exécutif 05-468 compliance fields, DZD-only,
// gapless per-org sequential numbering, unified partners table.
// ---------------------------------------------------------------------------

model TaxRate {
  id        String  @id @default(uuid())
  orgId     String
  name      String
  rate      Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false)

  organization Organization  @relation(fields: [orgId], references: [id])
  invoiceLines InvoiceLine[]

  @@index([orgId])
  @@map("tax_rates")
}

// Unified customer/supplier entity (§9 decision #9) — one real-world company
// can be both, flagged via booleans rather than duplicated as two records.
model Partner {
  id         String  @id @default(uuid())
  orgId      String
  name       String
  isCustomer Boolean @default(false)
  isSupplier Boolean @default(false)
  nif        String  // required — 2022 finance law ties buyer VAT deduction to it
  nis        String?
  rc         String?
  taxArticle String?
  address    String?
  phone      String?
  email      String?

  organization   Organization    @relation(fields: [orgId], references: [id])
  invoices       Invoice[]
  stockMovements StockMovement[]

  @@index([orgId])
  @@map("partners")
}

enum InvoiceType {
  CUSTOMER
  SUPPLIER
}

// number/status lifecycle differs by type — see docs/MILESTONE_4.md for the
// full reasoning, in short:
//   CUSTOMER (an invoice THIS org issues): draft (number=null, mutable) ->
//     finalize assigns the gapless number via InvoiceCounter below and
//     triggers stock OUT movements for stock-linked lines -> unpaid ->
//     partially_paid -> paid. Only a draft may be voided.
//   SUPPLIER (a bill THIS org received): created already carrying the
//     SUPPLIER's own reference as `number` (never auto-assigned, never
//     compliance-numbered by us, no stock movement — Purchasing/receiving
//     is Phase 2, out of scope) -> unpaid -> partially_paid -> paid.
model Invoice {
  id            String      @id @default(uuid())
  orgId         String
  siteId        String      // added for Milestone 4 — a stock-deducting line needs to know which site's stock to draw down; independent of the org-wide numbering sequence.
  type          InvoiceType
  number        String?     // nullable: null while a CUSTOMER invoice is still a draft (§8/§9 — Décret 05-468)
  partnerId     String?     // null = "vente comptoir" / walk-in — the confirmed override path, not a separate flag (see docs/MILESTONE_4.md)
  currency      String      @default("DZD") // DZD-only in Phase 1 (§9); field kept for a future multi-currency addition
  status        String      @default("draft") // draft | unpaid | partially_paid | paid | void
  issuedAt      DateTime    @default(now())
  finalizedAt   DateTime?   // set when a CUSTOMER invoice's number is assigned; set at creation time for SUPPLIER invoices
  transmissionStatus String? // placeholder for Algeria's DGI e-invoicing/CTC platform — no active integration yet (§8/§9)

  organization Organization  @relation(fields: [orgId], references: [id])
  site         Site          @relation(fields: [siteId], references: [id])
  partner      Partner?      @relation(fields: [partnerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  reminders    InvoiceReminder[]

  @@unique([orgId, number])
  @@index([orgId])
  @@map("invoices")
}

// Backs the gapless, per-organization, per-calendar-year sequential number
// (§8/§9 — Décret 05-468). Scoped by year to match the "FA-2026-000184"
// format already shown in docs/Wireframes.html — an explicit interpretation
// of "gapless per organization" the Action Plan itself didn't pin down to a
// specific format, documented in docs/MILESTONE_4.md. Incremented via a
// single atomic `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` statement
// (not a read-then-write from application code), which is safe under
// concurrent finalization because Postgres serializes concurrent statements
// touching the same row via its normal row-level locking — see
// InvoicingService.finalize's own comment for the exact mechanism.
model InvoiceCounter {
  orgId      String
  year       Int
  lastNumber Int @default(0)

  organization Organization @relation(fields: [orgId], references: [id])

  @@id([orgId, year])
  @@map("invoice_counters")
}

model InvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String
  productId       String? // nullable — a services-only business can invoice with no Stock module at all
  description     String
  quantity        Decimal @db.Decimal(14, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(14, 2)
  taxRateId       String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  @@map("invoice_lines")
}

// Multiple partial payments per invoice supported (§9 decision #8) — status
// tracks unpaid -> partially_paid -> paid against a running balance.
model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model InvoiceReminder {
  id        String   @id @default(uuid())
  invoiceId String
  sentAt    DateTime @default(now())
  channel   String   @default("email")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_reminders")
}

// ---------------------------------------------------------------------------
// Audit (§4) — generic, populated via an interceptor across Stock/Quality/
// Invoicing from day one; also the input for Phase 3 Comptabilité/Rapports.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String?
  entityType String
  entityId   String
  action     String
  diff       Json?
  occurredAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, occurredAt])
  @@map("audit_log")
}
